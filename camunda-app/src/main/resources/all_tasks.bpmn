  <bpmn:process id="all_tasks" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1yfilfv</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1yfilfv" sourceRef="StartEvent_1" targetRef="Activity_1wxm7pw" />
    <bpmn:scriptTask id="Activity_1wxm7pw" name="Initialize the User object" scriptFormat="javascript" camunda:resultVariable="userObj">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="objUser5">
            <camunda:script scriptFormat="javascript">var data={

  id: 6,
name :"Test"
};

data;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="userObj3">
            <camunda:script scriptFormat="javascript">var obj= {
    id:"20",
    name :"Sammy"
}

obj;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="userObj2">
            <camunda:script scriptFormat="javascript">var obj= {
    id:"10",
    name :"kanishk"
}

obj;</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yfilfv</bpmn:incoming>
      <bpmn:outgoing>Flow_0ar8r5f</bpmn:outgoing>
      <bpmn:script>var obj= {
    id:"29",
    name :"bhaskar"
}

print("The userObject ::" + JSON.stringify(obj));


var obj4= {
    id:"27",
    name :"Soni"
}

execution.setVariable("userObj4",obj4);

print("The userObject 5 ::" + JSON.stringify(objUser5));

obj;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0ar8r5f" sourceRef="Activity_1wxm7pw" targetRef="Activity_0x15x4e" />
    <bpmn:scriptTask id="Activity_0x15x4e" name="Initialize department object" scriptFormat="javascript" camunda:resource="initialize_Department.js">
      <bpmn:incoming>Flow_0ar8r5f</bpmn:incoming>
      <bpmn:outgoing>Flow_0weyq56</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0weyq56" sourceRef="Activity_0x15x4e" targetRef="Activity_1ebq6ek" />
    <bpmn:endEvent id="Event_1au74i4">
      <bpmn:incoming>Flow_041beuw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_1ebq6ek" name="FetchEmail Service" camunda:class="com.krishan.delegates.FetchEmailDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="userIdInput">
            <camunda:script scriptFormat="javascript">var a=2;
a;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="javascript">print("userEmailFromDelegate ===&gt;" +userEmailFromDelegate);

userObj.emailId=userEmailFromDelegate;

print("The userObj ==&gt;"+ JSON.stringify(userObj));</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0weyq56</bpmn:incoming>
      <bpmn:outgoing>Flow_1ezlv7s</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1ezlv7s" sourceRef="Activity_1ebq6ek" targetRef="Activity_1xoi37w" />
    <bpmn:serviceTask id="Activity_1xoi37w" name="Fetch User Role" camunda:delegateExpression="${fetchUserRoleDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="javascript">print("userRoleFromDelegate ==&gt;" +userRoleFromDelegate);

userObj.roles= userRoleFromDelegate;

print("The user Updated "+JSON.stringify(userObj));</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ezlv7s</bpmn:incoming>
      <bpmn:outgoing>Flow_1v49hb1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1v49hb1" sourceRef="Activity_1xoi37w" targetRef="Activity_0t63jkz" />
    <bpmn:serviceTask id="Activity_0t63jkz" name="Fetch User department" camunda:expression="${fetchUserDepartment.findUserDepartment()}" camunda:resultVariable="userDepartment">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="javascript">print("userDepartment ::"+ userDepartment);

userObj.department= userDepartment;

print("The user Updated "+JSON.stringify(userObj));</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1v49hb1</bpmn:incoming>
      <bpmn:outgoing>Flow_06y9kl2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_06y9kl2" sourceRef="Activity_0t63jkz" targetRef="Activity_0j5qmqz" />
    <bpmn:serviceTask id="Activity_0j5qmqz" name="Http Connector GET">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">https://api.escuelajs.co/api/v1/users</camunda:inputParameter>
            <camunda:outputParameter name="responseGet">
              <camunda:script scriptFormat="javascript">var users = JSON.parse(response);
print("User name = " + users[0].name);
users[0].name;</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06y9kl2</bpmn:incoming>
      <bpmn:outgoing>Flow_1y1q2sp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1y1q2sp" sourceRef="Activity_0j5qmqz" targetRef="Activity_1xet58w" />
    <bpmn:sequenceFlow id="Flow_041beuw" sourceRef="Activity_1xet58w" targetRef="Event_1au74i4" />
    <bpmn:serviceTask id="Activity_1xet58w" name="Http Connector  POST">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="javascript">var obj= {
    "userId": 5,
    "id": 5,
    "title": "Test",
    "body": "Test"
  };

JSON.stringify(obj);</camunda:script>
            </camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">https://jsonplaceholder.typicode.com/posts</camunda:inputParameter>
            <camunda:outputParameter name="responsePOST">
              <camunda:script scriptFormat="javascript">print("responsePOST ==&gt;"+ response);

response;</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1y1q2sp</bpmn:incoming>
      <bpmn:outgoing>Flow_041beuw</bpmn:outgoing>
    </bpmn:serviceTask>
