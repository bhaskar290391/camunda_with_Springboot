    <bpmn:endEvent id="Event_1au74i4">
      <bpmn:incoming>Flow_041beuw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_1ebq6ek" name="FetchEmail Service" camunda:class="com.krishan.delegates.FetchEmailDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="userIdInput">
            <camunda:script scriptFormat="javascript">var a=2;
a;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="javascript">print("userEmailFromDelegate ===&gt;" +userEmailFromDelegate);

userObj.emailId=userEmailFromDelegate;

print("The userObj ==&gt;"+ JSON.stringify(userObj));</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0weyq56</bpmn:incoming>
      <bpmn:outgoing>Flow_1ezlv7s</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1ezlv7s" sourceRef="Activity_1ebq6ek" targetRef="Activity_1xoi37w" />
    <bpmn:serviceTask id="Activity_1xoi37w" name="Fetch User Role" camunda:delegateExpression="${fetchUserRoleDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="javascript">print("userRoleFromDelegate ==&gt;" +userRoleFromDelegate);

userObj.roles= userRoleFromDelegate;

print("The user Updated "+JSON.stringify(userObj));</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ezlv7s</bpmn:incoming>
      <bpmn:outgoing>Flow_1v49hb1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1v49hb1" sourceRef="Activity_1xoi37w" targetRef="Activity_0t63jkz" />
    <bpmn:serviceTask id="Activity_0t63jkz" name="Fetch User department" camunda:expression="${fetchUserDepartment.findUserDepartment()}" camunda:resultVariable="userDepartment">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="temp">
            <camunda:script scriptFormat="javascript">print("userDepartment ::"+ userDepartment);

userObj.department= userDepartment;

print("The user Updated "+JSON.stringify(userObj));</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1v49hb1</bpmn:incoming>
      <bpmn:outgoing>Flow_06y9kl2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_06y9kl2" sourceRef="Activity_0t63jkz" targetRef="Activity_0j5qmqz" />
    <bpmn:serviceTask id="Activity_0j5qmqz" name="Http Connector GET">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">https://api.escuelajs.co/api/v1/users</camunda:inputParameter>
            <camunda:outputParameter name="responseGet">
              <camunda:script scriptFormat="javascript">var users = JSON.parse(response);
print("User name = " + users[0].name);
users[0].name;</camunda:script>
            </camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06y9kl2</bpmn:incoming>
      <bpmn:outgoing>Flow_1y1q2sp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1y1q2sp" sourceRef="Activity_0j5qmqz" targetRef="Activity_1xet58w" />
