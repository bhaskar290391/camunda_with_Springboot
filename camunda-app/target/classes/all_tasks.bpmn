  <bpmn:process id="all_tasks" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1yfilfv</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1yfilfv" sourceRef="StartEvent_1" targetRef="Activity_1wxm7pw" />
    <bpmn:scriptTask id="Activity_1wxm7pw" name="Initialize the User object" scriptFormat="javascript" camunda:resultVariable="userObj">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="objUser5">
            <camunda:script scriptFormat="javascript">var data={

  id: 6,
name :"Test"
};

data;</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="userObj3">
            <camunda:script scriptFormat="javascript">var obj= {
    id:"20",
    name :"Sammy"
}

obj;</camunda:script>
          </camunda:outputParameter>
          <camunda:outputParameter name="userObj2">
            <camunda:script scriptFormat="javascript">var obj= {
    id:"10",
    name :"kanishk"
}

obj;</camunda:script>
          </camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yfilfv</bpmn:incoming>
      <bpmn:outgoing>Flow_0ar8r5f</bpmn:outgoing>
      <bpmn:script>var obj= {
    id:"29",
    name :"bhaskar"
}

print("The userObject ::" + JSON.stringify(obj));


var obj4= {
    id:"27",
    name :"Soni"
}

execution.setVariable("userObj4",obj4);

print("The userObject 5 ::" + JSON.stringify(objUser5));

obj;</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0ar8r5f" sourceRef="Activity_1wxm7pw" targetRef="Activity_0x15x4e" />
    <bpmn:scriptTask id="Activity_0x15x4e" name="Initialize department object" scriptFormat="javascript" camunda:resource="initialize_Department.js">
      <bpmn:incoming>Flow_0ar8r5f</bpmn:incoming>
      <bpmn:outgoing>Flow_0weyq56</bpmn:outgoing>
    </bpmn:scriptTask>
